APP_NAME=AI Meeting Brain
APP_VERSION=1.0.0
DEBUG=False

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ai_meeting_brain_fyp
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

OPENROUTER_API_KEY=
BYTEZ_API_KEY=

# Copy this file to .env at the REPOSITORY ROOT, not inside backend.
# Free fallback needs no AI account. For fluent generation use your OpenRouter
# key (auto), or install Ollama and set LLM_PROVIDER=ollama.
LLM_PROVIDER=auto
CHAT_MODEL=openrouter/free
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# local = offline lexical retrieval. For semantic search use ollama/openrouter
# and set EMBEDDING_MODEL to a model supported by that provider. Reprocess
# meetings after changing it; SQL retrieval remains available in the meantime.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Employee-only conferencing requires private Jitsi. See deployment/JITSI.md.
# Recording uploads work without a conference server.
JITSI_DOMAIN=meet.your-company.com
JITSI_APP_ID=meeting-brain
JITSI_APP_SECRET=
JITSI_JWT_SUBJECT=meet.jitsi
# Enable only after JWT auth is configured and guest/empty-token access disabled.
JITSI_REQUIRE_AUTH=false
MANAGED_JITSI=false
# For the local certificate only. Leave empty for publicly trusted HTTPS.
JITSI_CA_BUNDLE=
# Strong multilingual model for English/Urdu/Hindi meetings. First use may
# download several GB into backend/data/models. Use small only on low-RAM PCs.
WHISPER_MODEL=large-v3
# Upgrade older small/base .env values to large-v3 automatically. Set false only on low-RAM PCs.
WHISPER_PREFER_LARGE_V3=true
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=8
WHISPER_CPU_THREADS=0
# Per-session language selector overrides this legacy-recording default.
# Blank/auto = mixed; en = English; ur = Urdu; hi = Hindi.
WHISPER_LANGUAGE=
MAX_AUDIO_MB=250
WORKER_ENABLED=true
# Optional absolute path. Default: backend/data
# DATA_DIR=

# --- Password recovery ---
# For a local FYP demo without SMTP, set PASSWORD_RESET_DEV_MODE=true to show
# the one-time reset link in the browser. Keep it false outside a trusted demo LAN.
# For real deployment configure SMTP and keep
# PASSWORD_RESET_DEV_MODE=false.
PASSWORD_RESET_DEV_MODE=false
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false


# --- Automation webhooks (optional) ---
N8N_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGINS=

# --- Zoom integration (optional) ---
# Create a "Server-to-Server OAuth" app in the Zoom App Marketplace.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
